rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'usernameLower', 'deviceId',
          'location', 'createdAt', 'updatedAt', 'lastSeenAt'
        ]);
      allow delete: if false;

      match /gameState/{stateId} {
        allow read, write: if signedInAs(uid) && stateId == 'current';
      }
    }

    match /usernames/{usernameLower} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && usernameLower == request.resource.data.username.lower();
      allow update, delete: if false;
    }
  }
}
